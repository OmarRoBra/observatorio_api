{
    "version": 2,
    "buildCommand": "npm run build",
    "builds": [
        {
            "src": "dist/index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "dist/index.js"
        }
    ],
    "crons": [
        {
            "path": "/health",
            "schedule": "0 8 * * *"
        }
    ]
}
